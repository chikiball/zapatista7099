---
import '../styles/global.css'

interface Props {
  title: string;
}

const { title } = Astro.props;

// Bump this whenever the favicon / app icons change, to bust browser caches.
const iconV = '3';
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Force HTTPS. TLS terminates upstream; browsers that don't auto-upgrade
      // (e.g. Chrome incognito, no HSTS) would otherwise load over HTTP and the
      // Secure session cookie gets dropped -> login bounces. Redirect once.
      if (location.protocol === "http:" && location.hostname !== "localhost" && location.hostname !== "127.0.0.1") {
        location.replace("https://" + location.host + location.pathname + location.search + location.hash);
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="7099 - Alumni SMAN 70 Jakarta Angkatan 99" />
    <link rel="icon" href={`/favicon.ico?v=${iconV}`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32.png?v=${iconV}`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`/favicon-16.png?v=${iconV}`} />
    <link rel="manifest" href={`/manifest.json?v=${iconV}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&display=swap" />
    <meta name="theme-color" content="#92400e" />
    <link rel="apple-touch-icon" href={`/icon-180.png?v=${iconV}`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Zapatista 7099" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900">
    <slot />
  </body>
</html>
