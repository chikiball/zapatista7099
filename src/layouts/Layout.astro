---
import '../styles/global.css'

interface Props {
  title: string;
}

const { title } = Astro.props;

// Bump this whenever the favicon / app icons change, to bust browser caches.
const iconV = '3';
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Force HTTPS. TLS terminates upstream; browsers that don't auto-upgrade
      // (e.g. Chrome incognito, no HSTS) would otherwise load over HTTP and the
      // Secure session cookie gets dropped -> login bounces. Redirect once.
      if (location.protocol === "http:" && location.hostname !== "localhost" && location.hostname !== "127.0.0.1") {
        location.replace("https://" + location.host + location.pathname + location.search + location.hash);
      }
      // Detect in-app browsers (WhatsApp/IG/FB/Line/TikTok/Twitter/Android WebView).
      // These break Google Sign-In (disallowed_useragent) and drop cookies, so we
      // steer users to a real browser. Helpers used by the banner + /login interstitial.
      (function () {
        var ua = navigator.userAgent || "";
        window.__inAppBrowser = /(WhatsApp|Instagram|FBAN|FBAV|FB_IAB|Line\/|musical_ly|BytedanceWebview|TikTok|Twitter|GSA\/|; wv\))/i.test(ua);
        window.__isAndroid = /Android/i.test(ua);
        window.__openExternal = function () {
          if (window.__isAndroid) {
            location.href = "intent://" + location.host + location.pathname + location.search +
              "#Intent;scheme=https;package=com.android.chrome;end";
          }
        };
        window.__copyLink = function (btn) {
          var u = location.href.replace(/^http:/, "https:");
          function done() { if (btn) { btn.textContent = "Tersalin!"; setTimeout(function () { btn.textContent = "Salin link"; }, 2000); } }
          if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(u).then(done).catch(function () { window.prompt("Salin link ini:", u); }); }
          else { window.prompt("Salin link ini:", u); }
        };
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="7099 - Alumni SMAN 70 Jakarta Angkatan 99" />
    <link rel="icon" href={`/favicon.ico?v=${iconV}`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32.png?v=${iconV}`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`/favicon-16.png?v=${iconV}`} />
    <link rel="manifest" href={`/manifest.json?v=${iconV}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&display=swap" />
    <meta name="theme-color" content="#92400e" />
    <link rel="apple-touch-icon" href={`/icon-180.png?v=${iconV}`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Zapatista 7099" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900">
    <div id="inapp-banner" class="hidden bg-amber-100 border-b border-amber-300 px-4 py-2 text-sm text-amber-900 flex items-center gap-2">
      <span class="flex-1">Untuk pengalaman & login terbaik, buka di browser (Chrome/Safari).</span>
      <button type="button" id="inapp-open" class="hidden bg-amber-700 text-white rounded-lg px-2 py-1 text-xs font-semibold" onclick="window.__openExternal()">Buka</button>
      <button type="button" class="bg-white border border-amber-300 rounded-lg px-2 py-1 text-xs" onclick="window.__copyLink(this)">Salin link</button>
      <button type="button" class="text-amber-700 px-1 text-lg leading-none" onclick="this.parentElement.remove()">&times;</button>
    </div>
    <slot />
    <footer id="site-footer" class="text-center text-xs text-stone-400 py-6 px-4">
      <a href="/terms" class="hover:text-amber-700 underline">Syarat &amp; Ketentuan</a>
      <span class="mx-1">·</span>
      7099 Alumni SMU 70 Angkatan 99
    </footer>
    <div id="tos-gate" class="hidden fixed inset-0 z-[110] bg-black/50 flex items-center justify-center px-4">
      <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md text-center">
        <h2 class="text-lg font-bold text-stone-800 mb-2">Syarat &amp; Ketentuan</h2>
        <p class="text-sm text-stone-600 mb-5">Sebelum melanjutkan, mohon baca dan setujui Syarat &amp; Ketentuan penggunaan situs ini (termasuk data yang dikumpulkan dan penggunaan AI).</p>
        <a href="/terms" class="block text-amber-700 underline text-sm mb-5">Baca Syarat &amp; Ketentuan lengkap</a>
        <button type="button" id="tos-gate-agree" class="w-full bg-amber-800 text-white rounded-xl px-4 py-3 font-semibold hover:bg-amber-900 transition mb-2">Saya Setuju</button>
        <button type="button" id="tos-gate-logout" class="text-xs text-stone-400 underline">Keluar</button>
      </div>
    </div>
    <script is:inline>
      // Soft banner on every page EXCEPT /login (which has its own hard interstitial)
      (function () {
        if (!window.__inAppBrowser) return;
        if (location.pathname.replace(/\/$/, "") === "/login") return;
        var b = document.getElementById("inapp-banner");
        if (!b) return;
        b.classList.remove("hidden");
        if (window.__isAndroid) document.getElementById("inapp-open").classList.remove("hidden");
      })();

      // Avoid a double footer on pages that render their own <footer> (e.g. homepage)
      (function () {
        if (document.querySelectorAll("footer").length > 1) {
          var f = document.getElementById("site-footer"); if (f) f.remove();
        }
      })();

      // Terms & Conditions gate: any logged-in user who hasn't accepted must agree
      // before using the site. Skipped on pages where the user needs to act first.
      (function () {
        var path = location.pathname.replace(/\/$/, "");
        if (path === "/login" || path === "/terms" || path === "/reset") return;
        fetch("/api/auth/me", { credentials: "include", cache: "no-store" })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (!d || !d.user || d.user.tos_accepted) return;
            var gate = document.getElementById("tos-gate");
            gate.classList.remove("hidden");
            document.getElementById("tos-gate-agree").onclick = function () {
              var btn = this; btn.disabled = true; btn.textContent = "Menyimpan...";
              fetch("/api/auth/accept-tos", { method: "POST", credentials: "include" })
                .then(function () { gate.classList.add("hidden"); })
                .catch(function () { btn.disabled = false; btn.textContent = "Saya Setuju"; });
            };
            document.getElementById("tos-gate-logout").onclick = function () {
              fetch("/api/auth/logout", { method: "POST", credentials: "include" }).then(function () { location.href = "/login"; });
            };
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>
