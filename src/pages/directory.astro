---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Direktori Alumni - 7099">
  <nav class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2 min-w-0">
        <a href="/" class="text-xl font-bold text-amber-900 shrink-0"><img src="/logo-nav.png" alt="Alumni 7099" style="height:32px"></a>
        <span id="nav-welcome" class="hidden text-sm text-stone-500 truncate">Welcome, <span id="nav-welcome-name" class="font-semibold text-amber-900"></span></span>
      </div>
      <a href="/profile" id="nav-login" class="text-sm text-amber-700 hover:underline shrink-0">Masuk</a>
    </div>
  </nav>

  <!-- Not logged in -->
  <div id="no-auth" class="hidden min-h-screen flex items-center justify-center px-4">
    <div class="text-center">
      <p class="text-stone-500 mb-4">Login untuk melihat direktori alumni</p>
      <a href="/login" class="bg-amber-800 text-white px-6 py-3 rounded-xl font-semibold hover:bg-amber-900 transition">Masuk / Daftar</a>
    </div>
  </div>

  <!-- Loading -->
  <div id="loading" class="flex items-center justify-center py-20"><p class="text-stone-400">Memuat direktori...</p></div>

  <!-- Content -->
  <div id="content" class="hidden">
    <div class="max-w-6xl mx-auto px-4 py-6">
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-stone-800">Direktori Alumni</h2>
          <p class="text-stone-500 text-sm" id="count-label">210 alumni</p>
        </div>
        <!-- Search -->
        <div class="w-full md:w-80">
          <input type="text" id="search" placeholder="Cari nama atau panggilan..." class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
        </div>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap gap-2 mb-6">
        <select id="filter-class1" class="border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white">
          <option value="">Semua Kelas 1</option>
        </select>
        <select id="filter-class2" class="border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white">
          <option value="">Semua Kelas 2</option>
        </select>
        <select id="filter-class3" class="border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white">
          <option value="">Semua Kelas 3</option>
        </select>
        <select id="filter-city" class="border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white">
          <option value="">Semua Kota</option>
        </select>
        <select id="sort-by" class="border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white">
          <option value="name">Nama A-Z</option>
          <option value="city">Kota</option>
          <option value="class">Kelas</option>
        </select>
        <button type="button" id="reset-btn" class="text-sm text-amber-700 hover:underline px-2 hidden">Reset</button>
      </div>

      <!-- Card Grid -->
      <div id="grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>

      <!-- No results -->
      <div id="no-results" class="hidden text-center py-12 text-stone-400">Tidak ada alumni yang cocok</div>
    </div>
  </div>

  <script is:inline>
  (function(){
    var allData=[],filtered=[];

    // Class suggestion option lists (mirror profile dropdowns + server CLASS_OPTIONS)
    var CLASS_OPTS={
      class1:["1-1","1-2","1-3","1-4","1-5","1-6","1-7","1-8","1-9","1-10","1-11","1-12","Lainnya"],
      class2:["2-A","2-B","2-C","2-D","2-E","2-F","2-G","2-H","2-I","2-J","2-K","2-L","Lainnya"],
      class:["IPA 1","IPA 2","IPA 3","IPA 4","IPA 5","IPA 6","IPA 7","IPA 8","IPS 1","IPS 2","IPS 3","IPS 4","Lainnya"]
    };
    var CLASS_META={class1:{icon:'📗',label:'Kelas 1'},class2:{icon:'📘',label:'Kelas 2'},class:{icon:'🎓',label:'Kelas 3'}};

    function tallyText(list){
      if(!list||!list.length)return '';
      return list.map(function(t){return t.value+' ('+t.count+')'}).join(' · ');
    }
    // Suggestion prompt for an EMPTY class field. Returns '' when there's nothing
    // to show (own card with no suggestions yet).
    function suggestBlock(a,field){
      var m=CLASS_META[field];
      var list=(a.suggestions&&a.suggestions[field])||[];
      var mine=(a.my_suggestions&&a.my_suggestions[field])||'';
      if(a.is_self&&!list.length)return '';
      var html='<div class="text-xs text-stone-400">'+m.icon+' '+m.label+': ';
      if(list.length){html+='<span class="text-stone-500">usulan teman → '+tallyText(list)+'</span>';}
      else{html+='<span class="text-stone-300 italic">belum ada</span>';}
      if(!a.is_self){
        var lbl=mine?('✎ '+mine):'＋ sarankan';
        html+=' <button type="button" class="suggest-btn text-amber-700 hover:underline" data-aid="'+a.id+'" data-field="'+field+'">'+lbl+'</button>';
      }
      html+='</div>';
      return html;
    }

    function submitSuggestion(aid,field,value){
      fetch('/api/directory/'+aid+'/suggest-class',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({field:field,value:value})})
        .then(function(r){return r.json().then(function(d){return {ok:r.ok,d:d}})})
        .then(function(res){
          if(!res.ok){alert((res.d&&res.d.error)||'Gagal menyimpan usulan');return;}
          var a=allData.filter(function(x){return String(x.id)===String(aid)})[0];
          if(a){a.suggestions=a.suggestions||{};a.suggestions[field]=res.d.tally;a.my_suggestions=a.my_suggestions||{};a.my_suggestions[field]=res.d.mine;}
          renderCards();
        }).catch(function(){alert('Gagal terhubung ke server')});
    }

    // Check auth
    fetch('/api/auth/me',{credentials:'include'}).then(function(r){
      if(!r.ok){
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('no-auth').classList.remove('hidden');
        return;
      }
      r.json().then(function(u){
        document.getElementById('nav-login').textContent='Profile';
        document.getElementById('nav-login').href='/profile';
        var w=document.getElementById('nav-welcome');if(w){document.getElementById('nav-welcome-name').textContent=u.user.name||u.user.email;w.classList.remove('hidden')}
        loadDirectory();
      });
    }).catch(function(){
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('no-auth').classList.remove('hidden');
    });

    function loadDirectory(){
      fetch('/api/directory',{credentials:'include'}).then(function(r){return r.json()}).then(function(data){
        allData=data;
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('content').classList.remove('hidden');
        buildFilters();
        applyFilters();
      });
    }

    function buildFilters(){
      var class1={},class2={},class3={},cities={};
      allData.forEach(function(a){
        if(a.class1)class1[a.class1]=1;
        if(a.class2)class2[a.class2]=1;
        if(a.class)class3[a.class]=1;
        if(a.city)cities[a.city]=1;
      });
      function fill(id,map){
        var sel=document.getElementById(id);
        Object.keys(map).sort().forEach(function(c){
          var o=document.createElement('option');o.value=c;o.textContent=c;sel.appendChild(o);
        });
      }
      fill('filter-class1',class1);
      fill('filter-class2',class2);
      fill('filter-class3',class3);
      fill('filter-city',cities);
    }

    function applyFilters(){
      var q=(document.getElementById('search').value||'').toLowerCase().trim();
      var f1=document.getElementById('filter-class1').value;
      var f2=document.getElementById('filter-class2').value;
      var f3=document.getElementById('filter-class3').value;
      var fct=document.getElementById('filter-city').value;
      var sort=document.getElementById('sort-by').value;

      filtered=allData.filter(function(a){
        if(q&&a.name.toLowerCase().indexOf(q)<0&&(!a.nickname||a.nickname.toLowerCase().indexOf(q)<0))return false;
        if(f1&&a.class1!==f1)return false;
        if(f2&&a.class2!==f2)return false;
        if(f3&&a.class!==f3)return false;
        if(fct&&a.city!==fct)return false;
        return true;
      });

      filtered.sort(function(a,b){
        if(sort==='city')return(a.city||'').localeCompare(b.city||'');
        if(sort==='class')return(a.class||'').localeCompare(b.class||'');
        return(a.name||'').localeCompare(b.name||'');
      });

      document.getElementById('count-label').textContent='Menampilkan '+filtered.length+' dari '+allData.length+' alumni';
      document.getElementById('reset-btn').classList.toggle('hidden',!q&&!f1&&!f2&&!f3&&!fct);
      renderCards();
    }

    function renderCards(){
      var grid=document.getElementById('grid');
      var noRes=document.getElementById('no-results');
      if(!filtered.length){grid.innerHTML='';noRes.classList.remove('hidden');return;}
      noRes.classList.add('hidden');

      grid.innerHTML=filtered.map(function(a){
        var initials=(a.name||'?').split(' ').map(function(w){return w[0]}).join('').substring(0,2).toUpperCase();
        var colors=['#92400e','#b45309','#d97706','#a16207','#854d0e','#78350f','#ca8a04','#c2410c'];
        var bgColor=colors[initials.charCodeAt(0)%colors.length];

        var avatar=a.photo
          ?'<img src="/photos/'+a.photo+'" style="width:56px;height:56px;border-radius:50%;object-fit:cover">'
          :'<div style="width:56px;height:56px;border-radius:50%;background:'+bgColor+';color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px">'+initials+'</div>';

        var details='';
        if(a.city)details+='<div class="flex items-center gap-1 text-xs text-stone-500"><span>📍</span>'+a.city+'</div>';
        if(a.job_title)details+='<div class="flex items-center gap-1 text-xs text-stone-500"><span>💼</span>'+a.job_title+'</div>';
        if(a.class)details+='<div class="flex items-center gap-1 text-xs text-stone-500"><span>🎓</span>'+a.class+'</div>';

        var extra='';
        if(a.class1)extra+='<div class="text-xs text-stone-400">📗 Kelas 1: '+a.class1+'</div>';
        if(a.class2)extra+='<div class="text-xs text-stone-400">📘 Kelas 2: '+a.class2+'</div>';
        if(a.university)extra+='<div class="text-xs text-stone-400">🏫 '+a.university+'</div>';
        if(a.hobby)extra+='<div class="text-xs text-stone-400">🎮 '+a.hobby+'</div>';
        if(a.company)extra+='<div class="text-xs text-stone-400">🏢 '+a.company+'</div>';
        // Crowd-sourced class suggestions for whichever class fields are still empty.
        if(!a.class1)extra+=suggestBlock(a,'class1');
        if(!a.class2)extra+=suggestBlock(a,'class2');
        if(!a.class)extra+=suggestBlock(a,'class');

        return '<div class="bg-white rounded-xl shadow-sm p-4 hover:shadow-md transition">'
          +'<div class="flex items-start gap-3">'
          +avatar
          +'<div class="flex-1 min-w-0">'
          +'<div class="font-semibold text-stone-800 text-sm truncate">'+a.name+'</div>'
          +(a.nickname?'<div class="text-xs text-amber-700">('+a.nickname+')</div>':'')
          +'<div class="mt-1 space-y-0.5">'+details+'</div>'
          +'</div>'
          +'</div>'
          +(extra?'<div class="mt-3 pt-3 border-t border-stone-100 space-y-1">'+extra+'</div>':'')
          +'</div>';
      }).join('');
    }

    document.getElementById('search').addEventListener('input',applyFilters);
    document.getElementById('filter-class1').addEventListener('change',applyFilters);
    document.getElementById('filter-class2').addEventListener('change',applyFilters);
    document.getElementById('filter-class3').addEventListener('change',applyFilters);
    document.getElementById('filter-city').addEventListener('change',applyFilters);
    document.getElementById('sort-by').addEventListener('change',applyFilters);

    // Suggest control: clicking "＋ sarankan" swaps in a dropdown; picking a value submits.
    document.getElementById('grid').addEventListener('click',function(e){
      var btn=e.target.closest('.suggest-btn');
      if(!btn)return;
      var aid=btn.getAttribute('data-aid'),field=btn.getAttribute('data-field');
      var sel=document.createElement('select');
      sel.className='suggest-sel border border-stone-300 rounded px-1 py-0.5 text-xs bg-white';
      sel.setAttribute('data-aid',aid);sel.setAttribute('data-field',field);
      var ph=document.createElement('option');ph.value='';ph.textContent='pilih…';sel.appendChild(ph);
      (CLASS_OPTS[field]||[]).forEach(function(v){var o=document.createElement('option');o.value=v;o.textContent=v;sel.appendChild(o)});
      var a=allData.filter(function(x){return String(x.id)===String(aid)})[0];
      var mine=a&&a.my_suggestions&&a.my_suggestions[field];
      if(mine)sel.value=mine;
      btn.replaceWith(sel);sel.focus();
    });
    document.getElementById('grid').addEventListener('change',function(e){
      var sel=e.target.closest('.suggest-sel');
      if(!sel||!sel.value)return;
      submitSuggestion(sel.getAttribute('data-aid'),sel.getAttribute('data-field'),sel.value);
    });
    document.getElementById('reset-btn').addEventListener('click',function(){
      document.getElementById('search').value='';
      document.getElementById('filter-class1').value='';
      document.getElementById('filter-class2').value='';
      document.getElementById('filter-class3').value='';
      document.getElementById('filter-city').value='';
      document.getElementById('sort-by').value='name';
      applyFilters();
    });
  })();
  </script>
</Layout>
