---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Profil - 7099 Alumni">
  <div id="loading" class="min-h-screen flex items-center justify-center"><div class="text-stone-400">Memuat...</div></div>
  <div id="not-logged" class="hidden min-h-screen flex items-center justify-center px-4"><div class="text-center"><p class="text-stone-500 mb-4">Kamu belum masuk</p><a href="/login" class="bg-amber-800 text-white px-6 py-3 rounded-xl font-semibold hover:bg-amber-900 transition">Masuk / Daftar</a></div></div>

  <div id="profile-content" class="hidden">
    <nav class="bg-white shadow-sm sticky top-0 z-50"><div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between"><a href="/" class="text-xl font-bold text-amber-900"><img src="/logo-nav.png" alt="Alumni 7099" style="height:32px"></a><div class="flex items-center gap-4"><span class="text-sm text-stone-600" id="nav-name"></span><button type="button" onclick="logout()" class="text-sm text-red-600 hover:underline">Keluar</button></div></div></nav>

    <div class="max-w-2xl mx-auto px-4 py-8">
      <div id="incomplete-banner" class="hidden bg-amber-100 border border-amber-300 rounded-xl p-4 mb-6">
        <p class="text-amber-900 font-semibold text-sm">Profil kamu belum lengkap.</p>
        <p class="text-amber-800 text-sm mt-1">Lengkapi data berikut supaya kamu muncul di peta &amp; direktori: <span id="incomplete-fields" class="font-semibold"></span></p>
      </div>
      <div id="match-banner" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6"><p class="text-amber-800 font-medium text-sm">✅ Data kamu ditemukan di database alumni! Silakan cek dan perbarui jika perlu.</p></div>

      <div id="no-match-banner" class="hidden bg-stone-100 border border-stone-200 rounded-xl p-4 mb-6">
        <p class="text-stone-700 font-medium text-sm mb-3">Data kamu belum ada di database. Cari nama kamu atau isi data baru:</p>
        <input type="text" id="search-input" placeholder="Cari nama..." class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm" oninput="searchAlumni(this.value)">
        <div id="search-results" class="mt-2"></div>
      </div>

      <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8">
        <h2 class="text-xl font-bold text-stone-800 mb-6">Data Profil</h2>
        <form id="profile-form" onsubmit="saveProfile(event)">
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1">Nama Lengkap *</label>
              <input type="text" name="name" required data-req class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
            </div>
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1">Nama Panggilan</label>
              <input type="text" name="nickname" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
            </div>
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1">Tanggal Lahir</label>
              <input type="date" name="birthday" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
            </div>
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1">Jenis Kelamin</label>
              <select name="gender" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none bg-white">
                <option value="">-- Pilih --</option>
                <option value="Pria">Pria</option>
                <option value="Wanita">Wanita</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1">No. Telepon</label>
              <input type="tel" name="phone" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
            </div>
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1">Kota</label>
              <input type="text" name="city" data-req class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
            </div>
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1">Negara</label>
              <input type="text" name="country" value="Indonesia" data-req class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
            </div>
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1">Pekerjaan</label>
              <input type="text" name="job_title" data-req class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-stone-700 mb-1">Alamat</label>
              <input type="text" name="address" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" placeholder="Jl. Contoh No. 1, Kecamatan, Kota">
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-stone-700 mb-1">Perusahaan / Bidang Usaha</label>
              <input type="text" name="company" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-stone-700 mb-1">Universitas <span class="text-stone-400 font-normal">(pisahkan dengan koma jika lebih dari satu)</span></label>
              <input type="text" name="university" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" placeholder="UI, ITB, UGM">
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-stone-700 mb-1">Hobi &amp; Minat <span class="text-stone-400 font-normal">(pisahkan dengan koma)</span></label>
              <input type="text" name="hobby" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" placeholder="sports, music, photography, cooking">
            </div>
          <div class="md:col-span-2"><label class="block text-sm font-medium text-stone-700 mb-1">Kelas waktu kelas 1</label><select name="class1" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none bg-white"><option value="">-- Pilih --</option><option value="1-1">1-1</option><option value="1-2">1-2</option><option value="1-3">1-3</option><option value="1-4">1-4</option><option value="1-5">1-5</option><option value="1-6">1-6</option><option value="1-7">1-7</option><option value="1-8">1-8</option><option value="1-9">1-9</option><option value="1-10">1-10</option><option value="1-11">1-11</option><option value="1-12">1-12</option><option value="Lainnya">Lainnya</option></select></div>
          <div class="md:col-span-2"><label class="block text-sm font-medium text-stone-700 mb-1">Kelas waktu kelas 2</label><select name="class2" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none bg-white"><option value="">-- Pilih --</option><option value="2-A">2-A</option><option value="2-B">2-B</option><option value="2-C">2-C</option><option value="2-D">2-D</option><option value="2-E">2-E</option><option value="2-F">2-F</option><option value="2-G">2-G</option><option value="2-H">2-H</option><option value="2-I">2-I</option><option value="2-J">2-J</option><option value="2-K">2-K</option><option value="2-L">2-L</option><option value="Lainnya">Lainnya</option></select></div>
          <div class="md:col-span-2"><label class="block text-sm font-medium text-stone-700 mb-1">Kelas waktu kelas 3</label><select name="class" data-req class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none bg-white"><option value="">-- Pilih --</option><option value="IPA 1">IPA 1</option><option value="IPA 2">IPA 2</option><option value="IPA 3">IPA 3</option><option value="IPA 4">IPA 4</option><option value="IPA 5">IPA 5</option><option value="IPA 6">IPA 6</option><option value="IPA 7">IPA 7</option><option value="IPA 8">IPA 8</option><option value="IPS 1">IPS 1</option><option value="IPS 2">IPS 2</option><option value="IPS 3">IPS 3</option><option value="IPS 4">IPS 4</option><option value="Lainnya">Lainnya</option></select></div>
          </div>
          <button type="submit" class="mt-6 w-full bg-amber-800 text-white rounded-xl px-4 py-3 font-semibold hover:bg-amber-900 transition">Simpan</button>
          <div id="save-msg" class="hidden bg-green-50 text-green-700 text-sm p-3 rounded-lg mt-4"></div>
          <div id="save-err" class="hidden bg-red-50 text-red-700 text-sm p-3 rounded-lg mt-4"></div>
        </form>
      </div>

      <!-- Photo Upload Section -->
      <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 mt-6" id="photo-section">
        <h2 class="text-xl font-bold text-stone-800 mb-4">Foto</h2>
        <div id="photo-grid" class="grid grid-cols-3 gap-3 mb-4"></div>
        <label class="block">
          <span class="w-full bg-amber-50 border-2 border-dashed border-amber-300 text-amber-800 rounded-xl px-4 py-6 font-medium text-sm text-center cursor-pointer hover:bg-amber-100 transition flex flex-col items-center gap-2">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            Upload Foto (max 5MB, bisa pilih beberapa)
            <input type="file" id="photo-input" accept="image/*" multiple class="hidden">
          </span>
        </label>
        <div id="upload-msg" class="hidden text-sm mt-2"></div>
      </div>
      <div class="text-center mt-6"><a href="/" class="text-sm text-amber-700 hover:underline">&larr; Kembali ke Beranda</a></div>

      <!-- Password -->
      <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 mt-6">
        <h2 class="text-xl font-bold text-stone-800 mb-1" id="pw-title">Ganti Password</h2>
        <p class="text-xs text-stone-400 mb-4" id="pw-subtitle">Ubah password login email kamu.</p>
        <div id="pw-msg" class="hidden bg-green-50 text-green-700 text-sm p-3 rounded-lg mb-4"></div>
        <div id="pw-err" class="hidden bg-red-50 text-red-700 text-sm p-3 rounded-lg mb-4"></div>
        <form id="pw-form" onsubmit="changePassword(event)">
          <div id="pw-current-wrap" class="mb-4">
            <label class="block text-sm font-medium text-stone-700 mb-1">Password Saat Ini</label>
            <input type="password" id="pw-current" autocomplete="current-password" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
          </div>
          <div class="mb-4">
            <label class="block text-sm font-medium text-stone-700 mb-1">Password Baru</label>
            <input type="password" id="pw-new" required minlength="6" autocomplete="new-password" placeholder="Min. 6 karakter" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
          </div>
          <div class="mb-4">
            <label class="block text-sm font-medium text-stone-700 mb-1">Ulangi Password Baru</label>
            <input type="password" id="pw-confirm" required minlength="6" autocomplete="new-password" placeholder="Ketik ulang password baru" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
          </div>
          <button type="submit" id="pw-submit" class="w-full bg-amber-800 text-white rounded-xl px-4 py-3 font-semibold hover:bg-amber-900 transition">Ganti Password</button>
        </form>
      </div>

      <!-- Notification Settings -->
      <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 mt-6">
        <h2 class="text-xl font-bold text-stone-800 mb-4">Notifikasi</h2>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-stone-700">Email Notifikasi</p>
            <p class="text-xs text-stone-400 mt-0.5">Terima email saat ada artikel atau event baru</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="notify-toggle" class="sr-only peer" onchange="toggleNotify(this)">
            <div class="w-11 h-6 bg-stone-200 rounded-full peer peer-checked:bg-amber-700 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full"></div>
          </label>
        </div>
        <p id="notify-msg" class="hidden text-xs text-stone-500 mt-2"></p>
      </div>
    </div>
  </div>

  <script is:inline>
    var FIELDS = ["name","nickname","phone","city","country","job_title","company","bio","birthday","gender","address","hobby","university","class","class1","class2"];

    async function loadProfile(){try{var r=await fetch("/api/auth/me",{credentials:"include",cache:"no-store"});if(!r.ok){if(r.status===401){try{await fetch("/api/auth/logout",{method:"POST",credentials:"include"})}catch(e){}window.location.href="/login";return}showNotLogged();return}var d=await r.json();document.getElementById("loading").classList.add("hidden");document.getElementById("profile-content").classList.remove("hidden");document.getElementById("nav-name").textContent=d.user.name||d.user.email;document.getElementById("notify-toggle").checked=d.user.notify_email!==0;setupPasswordCard(!!d.user.has_password);if(d.profile){document.getElementById("match-banner").classList.remove("hidden");fillForm(d.profile)}else{document.getElementById("no-match-banner").classList.remove("hidden")}showIncomplete(d.missing_fields||[])}catch(e){showNotLogged()}}

    // Nudge for the specific empty required fields (not every field).
    function showIncomplete(missing){var f=document.getElementById("profile-form");Array.prototype.forEach.call(f.querySelectorAll("[data-req]"),function(el){el.classList.remove("ring-2","ring-amber-400","border-amber-400")});if(!missing.length){document.getElementById("incomplete-banner").classList.add("hidden");return}document.getElementById("incomplete-fields").textContent=missing.map(function(m){return m.label}).join(", ");document.getElementById("incomplete-banner").classList.remove("hidden");missing.forEach(function(m){var el=f.querySelector('[name="'+m.key+'"]');if(el){el.classList.add("ring-2","ring-amber-400","border-amber-400")}})}

    function showNotLogged(){document.getElementById("loading").classList.add("hidden");document.getElementById("not-logged").classList.remove("hidden")}

    // "Ganti Password" for accounts that have one; "Buat Password" for Google-only accounts.
    var hasPassword=true;
    function setupPasswordCard(has){
      hasPassword=has;
      document.getElementById("pw-title").textContent=has?"Ganti Password":"Buat Password";
      document.getElementById("pw-subtitle").textContent=has?"Ubah password login email kamu.":"Akun kamu login lewat Google. Buat password agar bisa juga login pakai email.";
      document.getElementById("pw-submit").textContent=has?"Ganti Password":"Buat Password";
      var cur=document.getElementById("pw-current-wrap");
      if(has){cur.classList.remove("hidden")}else{cur.classList.add("hidden")}
    }
    async function changePassword(e){
      e.preventDefault();
      var msg=document.getElementById("pw-msg"),err=document.getElementById("pw-err");
      msg.classList.add("hidden");err.classList.add("hidden");
      var cur=document.getElementById("pw-current").value,n1=document.getElementById("pw-new").value,n2=document.getElementById("pw-confirm").value;
      if(n1.length<6){err.textContent="Password baru minimal 6 karakter";err.classList.remove("hidden");return}
      if(n1!==n2){err.textContent="Konfirmasi password tidak sama";err.classList.remove("hidden");return}
      if(hasPassword&&!cur){err.textContent="Isi password saat ini";err.classList.remove("hidden");return}
      try{
        var body={new_password:n1};if(hasPassword)body.current_password=cur;
        var r=await fetch("/api/auth/change-password",{method:"POST",headers:{"Content-Type":"application/json"},credentials:"include",body:JSON.stringify(body)});
        var d=await r.json();
        if(!r.ok){err.textContent=d.error||"Gagal mengubah password";err.classList.remove("hidden");return}
        document.getElementById("pw-form").reset();
        setupPasswordCard(true);
        msg.textContent=d.had_password?"✅ Password berhasil diganti!":"✅ Password berhasil dibuat! Sekarang kamu bisa login pakai email juga.";
        msg.classList.remove("hidden");
        setTimeout(function(){msg.classList.add("hidden")},4000);
      }catch(e){err.textContent="Terjadi kesalahan. Coba lagi.";err.classList.remove("hidden")}
    }

    function fillForm(p){var f=document.getElementById("profile-form");FIELDS.forEach(function(k){if(p[k]&&f[k]){if(k==="gender"){f[k].value=p[k]}else{f[k].value=p[k]}}})}

    async function saveProfile(e){e.preventDefault();var f=e.target;var b={};FIELDS.forEach(function(k){b[k]=f[k]?f[k].value:""});try{var r=await fetch("/api/profile",{method:"PUT",headers:{"Content-Type":"application/json"},credentials:"include",body:JSON.stringify(b)});var d=await r.json();if(!r.ok){document.getElementById("save-err").textContent=d.error;document.getElementById("save-err").classList.remove("hidden");return}document.getElementById("save-msg").textContent="✅ Profil berhasil disimpan!";document.getElementById("save-msg").classList.remove("hidden");document.getElementById("save-err").classList.add("hidden");document.getElementById("no-match-banner").classList.add("hidden");document.getElementById("match-banner").classList.remove("hidden");fetch("/api/auth/me",{credentials:"include",cache:"no-store"}).then(function(r){return r.ok?r.json():null}).then(function(d){if(d)showIncomplete(d.missing_fields||[])});setTimeout(function(){document.getElementById("save-msg").classList.add("hidden")},3000)}catch(e){document.getElementById("save-err").textContent="Gagal menyimpan.";document.getElementById("save-err").classList.remove("hidden")}}

    var st;function searchAlumni(q){clearTimeout(st);if(q.length<2){document.getElementById("search-results").innerHTML="";return}st=setTimeout(async function(){var r=await fetch("/api/alumni/search?q="+encodeURIComponent(q),{credentials:"include"});var d=await r.json();var c=document.getElementById("search-results");if(!d.length){c.innerHTML='<p class="text-sm text-stone-500">Tidak ditemukan. Isi data baru di bawah.</p>';return}c.innerHTML=d.map(function(r){return '<button onclick="linkAlumni('+r.id+')" class="block w-full text-left px-3 py-2 text-sm hover:bg-amber-50 rounded-lg"><b>'+r.name+'</b> ('+r.nickname+') - '+r.city+'</button>'}).join("")},300)}

    async function linkAlumni(id){var r=await fetch("/api/profile/link",{method:"POST",headers:{"Content-Type":"application/json"},credentials:"include",body:JSON.stringify({alumni_id:id})});var d=await r.json();if(d.success){fillForm(d.profile);document.getElementById("no-match-banner").classList.add("hidden");document.getElementById("match-banner").classList.remove("hidden");document.getElementById("save-msg").textContent="✅ Data berhasil ditautkan!";document.getElementById("save-msg").classList.remove("hidden")}}

    async function logout(){await fetch("/api/auth/logout",{method:"POST",credentials:"include"});window.location.href="/login"}
    function toggleNotify(cb){fetch("/api/profile/notifications",{method:"PUT",headers:{"Content-Type":"application/json"},credentials:"include",body:JSON.stringify({notify_email:cb.checked?1:0})}).then(function(){var m=document.getElementById("notify-msg");m.textContent=cb.checked?"✅ Notifikasi diaktifkan":"🔕 Notifikasi dinonaktifkan";m.classList.remove("hidden");setTimeout(function(){m.classList.add("hidden")},2500)})}

    
    // Photo functions
    function loadPhotos(){
      fetch('/api/profile/photos',{credentials:'include'}).then(function(r){return r.json()}).then(function(photos){
        var grid=document.getElementById('photo-grid');
        if(!grid)return;
        grid.innerHTML='';
        photos.forEach(function(p){
          var div=document.createElement('div');
          div.style.cssText='position:relative;aspect-ratio:1;border-radius:8px;overflow:hidden;background:#f5f0e8';
          div.innerHTML='<img src="/photos/'+p.filename+'" style="width:100%;height:100%;object-fit:cover"><button type="button" onclick="deletePhoto('+p.id+')" style="position:absolute;top:4px;right:4px;background:rgba(0,0,0,.6);color:#fff;border:none;border-radius:50%;width:24px;height:24px;font-size:14px;cursor:pointer;line-height:24px;text-align:center">&times;</button>';
          grid.appendChild(div);
        });
      }).catch(function(){});
    }
    function deletePhoto(id){
      if(!confirm('Hapus foto ini?'))return;
      fetch('/api/profile/photos/'+id,{method:'DELETE',credentials:'include'}).then(function(r){return r.json()}).then(function(){loadPhotos()});
    }
    document.getElementById('photo-input').addEventListener('change',function(e){
      var files=e.target.files;if(!files.length)return;
      var form=new FormData();
      for(var i=0;i<files.length;i++)form.append('photos',files[i]);
      var msg=document.getElementById('upload-msg');
      msg.textContent='Mengupload...';msg.className='text-sm mt-2 text-amber-700';
      fetch('/api/profile/photos',{method:'POST',credentials:'include',body:form}).then(function(r){return r.json()}).then(function(d){
        if(d.success){msg.textContent='✅ '+d.photos.length+' foto berhasil diupload';msg.className='text-sm mt-2 text-green-700';loadPhotos()}
        else{msg.textContent='❌ '+d.error;msg.className='text-sm mt-2 text-red-700'}
        e.target.value='';
        setTimeout(function(){msg.className='hidden'},3000);
      }).catch(function(){msg.textContent='❌ Upload gagal';msg.className='text-sm mt-2 text-red-700'});
    });

    loadProfile();
  </script>
</Layout>
