---
import Layout from "../layouts/Layout.astro";
---

<Layout title="7099 - Alumni SMU 70 Angkatan 99">
  <!-- Navigation -->
  <nav class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2 min-w-0">
        <a href="/" class="block shrink-0"><img src="/logo-nav.png" alt="Alumni 7099" style="height:32px"></a>
        <span id="nav-welcome" class="hidden text-sm text-stone-500 truncate">Welcome, <span id="nav-welcome-name" class="font-semibold text-amber-900"></span></span>
      </div>
      <button type="button" class="md:hidden p-2 shrink-0" id="menu-toggle" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
      <ul class="hidden md:flex items-center space-x-6 text-sm font-medium text-gray-600">
        <li><a href="/" class="hover:text-amber-800">Home</a></li>
        <li><a href="/directory" class="hover:text-amber-800">Directory</a></li>
        <li><a href="/map" class="hover:text-amber-800">Map</a></li>
        <li><a href="/articles" class="hover:text-amber-800">Articles</a></li>
        <li><a href="/events" class="hover:text-amber-800">Events</a></li>
        <li><a href="/gallery" class="hover:text-amber-800">Gallery</a></li>
        <li><a href="/forum" class="hover:text-amber-800">Forum</a></li>
        <li><a href="/login" id="nav-login" class="text-amber-700 font-semibold hover:text-amber-900">Masuk</a></li>
      </ul>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-stone-100 px-4 py-2">
      <a href="/" class="block py-2 text-sm text-gray-600 hover:text-amber-800">Home</a>
      <a href="/directory" class="block py-2 text-sm text-gray-600 hover:text-amber-800">Directory</a>
      <a href="/map" class="block py-2 text-sm text-gray-600 hover:text-amber-800">Map</a>
      <a href="/articles" class="block py-2 text-sm text-gray-600 hover:text-amber-800">Articles</a>
      <a href="/events" class="block py-2 text-sm text-gray-600 hover:text-amber-800">Events</a>
      <a href="/gallery" class="block py-2 text-sm text-gray-600 hover:text-amber-800">Gallery</a>
      <a href="/forum" class="block py-2 text-sm text-gray-600 hover:text-amber-800">Forum</a>
      <a href="/login" id="nav-login-mobile" class="block py-2 text-sm text-amber-700 font-semibold">Masuk / Daftar</a>
    </div>
  </nav>

  <!-- Incomplete-profile nudge (shown to logged-in users missing required fields) -->
  <a href="/profile" id="complete-profile-banner" class="hidden block bg-amber-100 border-b border-amber-200 text-amber-900 text-sm text-center px-4 py-2 hover:bg-amber-200 transition">
    Profil kamu belum lengkap<span id="complete-profile-missing"></span>. <span class="font-semibold underline">Lengkapi sekarang →</span>
  </a>

  <!-- Hero Section -->
  <section style="background:linear-gradient(135deg,#c4ad93,#b39c82,#a38d74)" class="text-white py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <img src="/logo-hero.png" alt="7099" class="mx-auto mb-4" style="max-height:120px;width:auto">
      <p id="years-since" class="text-xl md:text-2xl opacity-90 mb-2">27 Tahun Kemudian, Tetap Terhubung</p>
      <p class="text-lg opacity-75 mb-8">Menghubungkan kembali teman-teman SMA kita</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/login" id="hero-cta" class="bg-white text-amber-900 px-8 py-3 rounded-full font-semibold hover:bg-amber-50 transition">Masuk / Daftar</a>
        <a href="/map" class="border-2 border-white text-white px-8 py-3 rounded-full font-semibold hover:bg-white/10 transition">Lihat Peta</a>
      </div>
    </div>
  </section>

  <!-- Stats Quick View -->
  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <h3 class="text-2xl font-bold text-center mb-12">Sekilas Tentang Kita</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <a href="/directory" class="bg-white p-6 rounded-xl shadow-sm text-center block hover:shadow-md transition">
          <div class="text-3xl font-bold text-amber-800" id="stat-alumni">--</div>
          <div class="text-sm text-gray-500 mt-1">Total Alumni</div>
        </a>
        <a href="/map" class="bg-white p-6 rounded-xl shadow-sm text-center block hover:shadow-md transition">
          <div class="text-3xl font-bold text-amber-700" id="stat-cities">--</div>
          <div class="text-sm text-gray-500 mt-1">Kota</div>
        </a>
        <a href="/stats" class="bg-white p-6 rounded-xl shadow-sm text-center block hover:shadow-md transition">
          <div class="text-3xl font-bold text-amber-600" id="stat-industries">--</div>
          <div class="text-sm text-gray-500 mt-1">Bidang Profesi</div>
        </a>
        <a href="/map" class="bg-white p-6 rounded-xl shadow-sm text-center block hover:shadow-md transition">
          <div class="text-3xl font-bold text-amber-900" id="stat-countries">--</div>
          <div class="text-sm text-gray-500 mt-1">Negara</div>
        </a>
      </div>
  </section>

  <!-- Features -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <h3 class="text-2xl font-bold text-center mb-12">Yang Ada di Sini</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        <a href="/map" class="text-center p-6 block hover:bg-amber-50 rounded-xl transition">
          <img src="/peta_interaktif.png" alt="Peta Interaktif" class="mx-auto mb-4" style="max-height:120px;width:auto">
          <p class="text-gray-600 text-sm">Lihat dimana teman-teman kita berada sekarang</p>
        </a>
        <a href="/stats" class="text-center p-6 block hover:bg-amber-50 rounded-xl transition">
          <img src="/statistik_kelas.png" alt="Statistik Angkatan" class="mx-auto mb-4" style="max-height:120px;width:auto">
          <p class="text-gray-600 text-sm">Profesi, kota, dan data menarik tentang angkatan kita</p>
        </a>
        <a href="/articles" class="text-center p-6 block hover:bg-amber-50 rounded-xl transition">
          <img src="/cerita_artikel.png" alt="Cerita &amp; Artikel" class="mx-auto mb-4" style="max-height:120px;width:auto">
          <p class="text-gray-600 text-sm">Bagikan perjalananmu dan baca cerita teman-teman</p>
        </a>
        <a href="/gallery" class="text-center p-6 block hover:bg-amber-50 rounded-xl transition">
          <img src="/galeri_foto.png" alt="Galeri Foto" class="mx-auto mb-4" style="max-height:120px;width:auto">
          <p class="text-gray-600 text-sm">Jelajahi koleksi foto kenangan angkatan kita</p>
        </a>
        <a href="/forum" class="text-center p-6 block hover:bg-amber-50 rounded-xl transition">
          <img src="/forum.png" alt="Forum" class="mx-auto mb-4" style="max-height:120px;width:auto">
          <p class="text-gray-600 text-sm">Ngobrol, tanya jawab, dan diskusi bareng alumni</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-amber-950 text-amber-200 py-8 px-4 text-center text-sm">
    <p>7099 - Alumni SMU 70 Angkatan 99 &copy; 2026 | Made with ❤️ by tim reuni 7099</p>
    <p class="mt-2"><a href="/terms" class="text-amber-300 hover:text-white underline">Syarat &amp; Ketentuan</a></p>
  </footer>

  <!-- Floating Du-Du comic bubble button -->
  <a href="/dudu" aria-label="Du-Du Wall"
     class="fixed bottom-5 right-5 z-40 group"
     style="transform:rotate(-8deg);transition:transform .25s">
    <div class="relative" style="width:88px;height:100px">
      <svg viewBox="0 0 120 135" width="88" height="100"
           style="filter:drop-shadow(0 4px 8px rgba(0,0,0,0.25));overflow:visible">
        <path d="M 60 7 C 92 7 108 28 108 55 C 108 78 94 94 76 98 L 38 128 L 52 96 C 28 90 12 74 12 55 C 12 28 28 7 60 7 Z"
              fill="#fef3c7" stroke="#1c1917" stroke-width="4" stroke-linejoin="round"/>
      </svg>
      <div class="absolute inset-0 flex flex-col items-center text-stone-900 font-black"
           style="font-family:'Caveat','Kalam','Comic Sans MS',cursive;line-height:0.9;padding-top:14px">
        <span style="font-size:28px">du</span>
        <span style="font-size:28px">du</span>
      </div>
    </div>
    <style>a[aria-label="Du-Du Wall"]:hover{transform:rotate(0deg) scale(1.1)!important}</style>
  </a>
  <script is:inline>document.getElementById("years-since").textContent=(new Date().getFullYear()-1999)+" Tahun Kemudian, Tetap Terhubung";fetch("/api/stats").then(function(r){return r.json()}).then(function(d){document.getElementById("stat-alumni").textContent=d.total_alumni;document.getElementById("stat-cities").textContent=d.total_cities;document.getElementById("stat-industries").textContent=d.total_industries;document.getElementById("stat-countries").textContent=d.total_countries}).catch(function(){});
  // Auth-aware nav: Masuk → Profile, greet by name, hide login CTAs, nudge incomplete profiles.
  fetch("/api/auth/me",{credentials:"include"}).then(function(r){return r.ok?r.json():null}).then(function(d){
    if(!d||!d.user)return;
    var name=d.user.name||d.user.email||"";
    var login=document.getElementById("nav-login");
    if(login){login.textContent="Profile";login.href="/profile"}
    var loginM=document.getElementById("nav-login-mobile");
    if(loginM){loginM.textContent="Profile";loginM.href="/profile"}
    var cta=document.getElementById("hero-cta");
    if(cta)cta.classList.add("hidden");
    var w=document.getElementById("nav-welcome");
    if(w){document.getElementById("nav-welcome-name").textContent=name;w.classList.remove("hidden")}
    if(!d.profile_complete){
      var b=document.getElementById("complete-profile-banner");
      if(b){
        var miss=(d.missing_fields||[]).map(function(f){return f.label});
        if(miss.length)document.getElementById("complete-profile-missing").textContent=" — lengkapi "+miss.join(", ");
        b.classList.remove("hidden");
      }
    }
  }).catch(function(){});</script>
</Layout>
