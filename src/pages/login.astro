---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Login - 7099 Alumni">
  <div id="inapp-interstitial" class="hidden fixed inset-0 z-[100] bg-white flex items-center justify-center px-6">
    <div class="w-full max-w-sm text-center">
      <img src="/logo-hero.png" alt="7099" style="height:56px;width:auto" class="mx-auto mb-6">
      <h2 class="text-xl font-bold text-stone-800 mb-2">Buka di browser dulu ya</h2>
      <p class="text-sm text-stone-600 mb-6">Kamu membuka lewat aplikasi (WhatsApp/Instagram/dll). Login Google tidak jalan di sini, jadi buka pakai <b>Chrome</b> atau <b>Safari</b>.</p>
      <button type="button" id="inapp-open-btn" class="hidden w-full bg-amber-800 text-white rounded-xl px-4 py-3 font-semibold mb-3" onclick="window.__openExternal()">Buka di Chrome</button>
      <button type="button" class="w-full bg-white border border-stone-300 rounded-xl px-4 py-3 font-semibold text-stone-700 mb-3" onclick="window.__copyLink(this)">Salin link</button>
      <p id="inapp-ios-hint" class="hidden text-xs text-stone-500 mb-4">Atau tap ikon <b>•••</b> di pojok, lalu pilih <b>Buka di Safari</b>.</p>
      <button type="button" class="text-xs text-stone-400 underline" onclick="document.getElementById('inapp-interstitial').classList.add('hidden')">Lanjut dengan email di sini</button>
    </div>
  </div>
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div id="reg-complete-modal" class="hidden fixed inset-0 z-[90] bg-black/40 flex items-center justify-center px-4">
      <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-sm">
        <h2 class="text-lg font-bold text-stone-800 mb-1">Lengkapi data kamu</h2>
        <p class="text-xs text-stone-500 mb-4">Supaya admin bisa mengenali kamu.</p>
        <div id="reg-complete-err" class="hidden bg-red-50 text-red-700 text-sm p-2 rounded-lg mb-3"></div>
        <label class="block text-sm font-medium text-stone-700 mb-1">Nama Lengkap</label>
        <input type="text" id="rc-name" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm mb-3 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
        <label class="block text-sm font-medium text-stone-700 mb-1">Kelas <span class="text-stone-400 font-normal">(isi minimal salah satu)</span></label>
        <div class="grid grid-cols-3 gap-2">
          <select id="rc-class1" class="w-full border border-stone-300 rounded-xl px-2 py-3 text-sm bg-white focus:ring-2 focus:ring-amber-500 outline-none"><option value="">Kelas 1</option><option value="1-1">1-1</option><option value="1-2">1-2</option><option value="1-3">1-3</option><option value="1-4">1-4</option><option value="1-5">1-5</option><option value="1-6">1-6</option><option value="1-7">1-7</option><option value="1-8">1-8</option><option value="1-9">1-9</option><option value="1-10">1-10</option><option value="1-11">1-11</option><option value="1-12">1-12</option><option value="Lainnya">Lainnya</option></select>
          <select id="rc-class2" class="w-full border border-stone-300 rounded-xl px-2 py-3 text-sm bg-white focus:ring-2 focus:ring-amber-500 outline-none"><option value="">Kelas 2</option><option value="2-A">2-A</option><option value="2-B">2-B</option><option value="2-C">2-C</option><option value="2-D">2-D</option><option value="2-E">2-E</option><option value="2-F">2-F</option><option value="2-G">2-G</option><option value="2-H">2-H</option><option value="2-I">2-I</option><option value="2-J">2-J</option><option value="2-K">2-K</option><option value="2-L">2-L</option><option value="Lainnya">Lainnya</option></select>
          <select id="rc-class3" class="w-full border border-stone-300 rounded-xl px-2 py-3 text-sm bg-white focus:ring-2 focus:ring-amber-500 outline-none"><option value="">Kelas 3</option><option value="IPA 1">IPA 1</option><option value="IPA 2">IPA 2</option><option value="IPA 3">IPA 3</option><option value="IPA 4">IPA 4</option><option value="IPA 5">IPA 5</option><option value="IPA 6">IPA 6</option><option value="IPA 7">IPA 7</option><option value="IPA 8">IPA 8</option><option value="IPS 1">IPS 1</option><option value="IPS 2">IPS 2</option><option value="IPS 3">IPS 3</option><option value="IPS 4">IPS 4</option><option value="Lainnya">Lainnya</option></select>
        </div>
        <button type="button" id="rc-submit" class="mt-5 w-full bg-amber-800 text-white rounded-xl px-4 py-3 font-semibold hover:bg-amber-900 transition">Simpan &amp; Lanjut</button>
      </div>
    </div>
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="flex justify-center"><img src="/logo-hero.png" alt="7099" style="height:60px;width:auto"></a>
        <p class="text-stone-500 mt-1">Alumni SMU 70 '99</p>
      </div>

      <div class="bg-white rounded-2xl shadow-lg p-8">
        <h2 class="text-xl font-bold text-stone-800 mb-6" id="form-title">Masuk</h2>

        <div id="error-msg" class="hidden bg-red-50 text-red-700 text-sm p-3 rounded-lg mb-4"></div>
        <div id="success-msg" class="hidden bg-green-50 text-green-700 text-sm p-3 rounded-lg mb-4"></div>

        <!-- Google Sign In - rendered by Google SDK -->
        <div id="google-btn-container" class="flex justify-center mb-4"></div>

        <div id="auth-divider" class="flex items-center gap-3 my-5">
          <div class="flex-1 h-px bg-stone-200"></div>
          <span class="text-xs text-stone-400 uppercase">atau</span>
          <div class="flex-1 h-px bg-stone-200"></div>
        </div>

        <form id="auth-form" onsubmit="handleSubmit(event)">
          <div id="name-field" class="hidden mb-4">
            <label class="block text-sm font-medium text-stone-700 mb-1">Nama Lengkap</label>
            <input type="text" id="name" placeholder="Nama kamu" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
          </div>
          <div id="kelas-field" class="hidden mb-4">
            <label class="block text-sm font-medium text-stone-700 mb-1">Kelas <span class="text-stone-400 font-normal">(isi minimal salah satu)</span></label>
            <div class="grid grid-cols-3 gap-2">
              <select id="reg-class1" class="w-full border border-stone-300 rounded-xl px-2 py-3 text-sm bg-white focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"><option value="">Kelas 1</option><option value="1-1">1-1</option><option value="1-2">1-2</option><option value="1-3">1-3</option><option value="1-4">1-4</option><option value="1-5">1-5</option><option value="1-6">1-6</option><option value="1-7">1-7</option><option value="1-8">1-8</option><option value="1-9">1-9</option><option value="1-10">1-10</option><option value="1-11">1-11</option><option value="1-12">1-12</option><option value="Lainnya">Lainnya</option></select>
              <select id="reg-class2" class="w-full border border-stone-300 rounded-xl px-2 py-3 text-sm bg-white focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"><option value="">Kelas 2</option><option value="2-A">2-A</option><option value="2-B">2-B</option><option value="2-C">2-C</option><option value="2-D">2-D</option><option value="2-E">2-E</option><option value="2-F">2-F</option><option value="2-G">2-G</option><option value="2-H">2-H</option><option value="2-I">2-I</option><option value="2-J">2-J</option><option value="2-K">2-K</option><option value="2-L">2-L</option><option value="Lainnya">Lainnya</option></select>
              <select id="reg-class3" class="w-full border border-stone-300 rounded-xl px-2 py-3 text-sm bg-white focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"><option value="">Kelas 3</option><option value="IPA 1">IPA 1</option><option value="IPA 2">IPA 2</option><option value="IPA 3">IPA 3</option><option value="IPA 4">IPA 4</option><option value="IPA 5">IPA 5</option><option value="IPA 6">IPA 6</option><option value="IPA 7">IPA 7</option><option value="IPA 8">IPA 8</option><option value="IPS 1">IPS 1</option><option value="IPS 2">IPS 2</option><option value="IPS 3">IPS 3</option><option value="IPS 4">IPS 4</option><option value="Lainnya">Lainnya</option></select>
            </div>
          </div>
          <div class="mb-4">
            <label class="block text-sm font-medium text-stone-700 mb-1">Email</label>
            <input type="email" id="email" required placeholder="email@contoh.com" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
          </div>
          <div class="mb-6">
            <label class="block text-sm font-medium text-stone-700 mb-1">Password</label>
            <input type="password" id="password" required minlength="6" placeholder="Min. 6 karakter" class="w-full border border-stone-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none">
          </div>
          <button type="submit" class="w-full bg-amber-800 text-white rounded-xl px-4 py-3 font-semibold hover:bg-amber-900 transition" id="submit-btn">Masuk</button>
        </form>
        <div class="text-center mt-3">
          <button type="button" onclick="showForgot()" class="text-xs text-stone-400 hover:text-amber-700">Lupa password?</button>
        </div>

        <p class="text-center text-sm text-stone-500 mt-6">
          <span id="toggle-text">Belum punya akun?</span>
          <button onclick="toggleMode()" id="forgot-link" class="text-amber-700 font-semibold hover:underline" id="toggle-btn">Daftar</button>
        </p>
      </div>
    </div>
  </div>

  <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
  <script is:inline>
    const GOOGLE_CLIENT_ID = "1035245406806-7dh06iqc9697ssos8tukbho0no2eaut5.apps.googleusercontent.com";
    let isSignup = false;

    // After auth: complete profiles go to the homepage, incomplete ones to /profile.
    // Use a full page navigation (NOT a second fetch) — Safari private mode won't send
    // a just-set cookie on an immediate follow-up fetch, but it does on navigation.
    function goAfterAuth(complete) {
      window.location.href = complete ? "/" : "/profile";
    }

    // Wait for Google SDK to load, then render the button
    function initGoogle() {
      if (typeof google === "undefined") {
        setTimeout(initGoogle, 200);
        return;
      }
      google.accounts.id.initialize({
        client_id: GOOGLE_CLIENT_ID,
        callback: handleGoogleSignIn,
        ux_mode: "popup",
      });
      google.accounts.id.renderButton(
        document.getElementById("google-btn-container"),
        {
          type: "standard",
          theme: "outline",
          size: "large",
          text: "signin_with",
          width: "360",
          logo_alignment: "center",
        }
      );
    }
    // In-app browsers: Google Sign-In is blocked (disallowed_useragent) and cookies
    // are flaky. Hide the Google button + its "atau" divider, and show the interstitial.
    if (window.__inAppBrowser) {
      var gc = document.getElementById("google-btn-container"); if (gc) gc.classList.add("hidden");
      var divider = document.getElementById("auth-divider"); if (divider) divider.classList.add("hidden");
      var inter = document.getElementById("inapp-interstitial");
      if (inter) {
        inter.classList.remove("hidden");
        if (window.__isAndroid) document.getElementById("inapp-open-btn").classList.remove("hidden");
        else document.getElementById("inapp-ios-hint").classList.remove("hidden");
      }
    } else {
      setTimeout(initGoogle, 300);
    }

    function toggleMode() {
      isSignup = !isSignup;
      document.getElementById("form-title").textContent = isSignup ? "Daftar Akun Baru" : "Masuk";
      document.getElementById("name-field").classList.toggle("hidden", !isSignup);
      document.getElementById("kelas-field").classList.toggle("hidden", !isSignup);
      document.getElementById("submit-btn").textContent = isSignup ? "Daftar" : "Masuk";
      document.getElementById("toggle-text").textContent = isSignup ? "Sudah punya akun?" : "Belum punya akun?";
      document.getElementById("toggle-btn").textContent = isSignup ? "Masuk" : "Daftar";
      hideMessages();
    }

    function showError(msg) {
      const el = document.getElementById("error-msg");
      el.textContent = msg; el.classList.remove("hidden");
      document.getElementById("success-msg").classList.add("hidden");
    }
    function showSuccess(msg) {
      const el = document.getElementById("success-msg");
      el.textContent = msg; el.classList.remove("hidden");
      document.getElementById("error-msg").classList.add("hidden");
    }
    function hideMessages() {
      document.getElementById("error-msg").classList.add("hidden");
      document.getElementById("success-msg").classList.add("hidden");
    }

    async function handleSubmit(e) {
      e.preventDefault();
      hideMessages();
      const email = document.getElementById("email").value;
      const password = document.getElementById("password").value;
      const name = document.getElementById("name").value;
      const class1 = document.getElementById("reg-class1").value;
      const class2 = document.getElementById("reg-class2").value;
      const class3 = document.getElementById("reg-class3").value;
      if (isSignup) {
        if (!name.trim()) { showError("Nama lengkap wajib diisi"); return; }
        if (!class1 && !class2 && !class3) { showError("Isi minimal salah satu Kelas (1, 2, atau 3)"); return; }
      }
      const url = isSignup ? "/api/auth/signup" : "/api/auth/login";

      try {
        const res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify(isSignup ? { email, password, name, class1, class2, class3 } : { email, password }),
        });
        const data = await res.json();
        if (!res.ok) { showError(data.error); return; }

        if (data.alumni_match) {
          showSuccess("Data ditemukan: " + data.alumni_match.name + " (" + data.alumni_match.nickname + "). Redirecting...");
        } else {
          showSuccess("Berhasil! Redirecting...");
        }
        setTimeout(function() { goAfterAuth(data.profile_complete); }, 800);
      } catch(err) {
        showError("Terjadi kesalahan. Coba lagi.");
      }
    }

    async function handleGoogleSignIn(response) {
      hideMessages();
      try {
        const res = await fetch("/api/auth/google", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ credential: response.credential }),
        });
        const data = await res.json();
        if (!res.ok) { showError(data.error); return; }

        // New Google user with no name/kelas yet -> require completion before continuing.
        if (data.needs_reg_info) { openRegComplete(data.token, data.user && data.user.name); return; }

        if (data.alumni_match) {
          showSuccess("Data ditemukan: " + data.alumni_match.name + ". Redirecting...");
        } else {
          showSuccess("Login Google berhasil! Redirecting...");
        }
        setTimeout(function() { goAfterAuth(data.profile_complete); }, 800);
      } catch(err) {
        showError("Google login gagal. Coba lagi.");
      }
    }

    // Required post-Google modal: collect name + >=1 Kelas, then continue to /profile.
    function openRegComplete(token, prefillName) {
      hideMessages();
      if (prefillName) document.getElementById("rc-name").value = prefillName;
      document.getElementById("reg-complete-modal").classList.remove("hidden");
      document.getElementById("rc-submit").onclick = async function () {
        var err = document.getElementById("reg-complete-err");
        err.classList.add("hidden");
        var name = document.getElementById("rc-name").value.trim();
        var c1 = document.getElementById("rc-class1").value;
        var c2 = document.getElementById("rc-class2").value;
        var c3 = document.getElementById("rc-class3").value;
        if (!name) { err.textContent = "Nama lengkap wajib diisi"; err.classList.remove("hidden"); return; }
        if (!c1 && !c2 && !c3) { err.textContent = "Isi minimal salah satu Kelas (1, 2, atau 3)"; err.classList.remove("hidden"); return; }
        try {
          var r = await fetch("/api/auth/complete-registration", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
            credentials: "include",
            body: JSON.stringify({ name: name, class1: c1, class2: c2, class3: c3 }),
          });
          var d = await r.json();
          if (!r.ok) { err.textContent = d.error || "Gagal menyimpan"; err.classList.remove("hidden"); return; }
          goAfterAuth(false); // new user -> profile is incomplete -> /profile
        } catch (e) { err.textContent = "Terjadi kesalahan. Coba lagi."; err.classList.remove("hidden"); }
      };
    }

    
    function showForgot(){
      var email=document.getElementById('email').value;
      if(!email){showError('Masukkan email dulu');return}
      hideMessages();
      fetch('/api/auth/forgot-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email})})
        .then(function(r){return r.json()}).then(function(){
          showSuccess('Link reset password telah dikirim ke email kamu (jika terdaftar)');
        }).catch(function(){showError('Gagal mengirim email')});
    }

    // Already logged in? Route based on profile completeness.
    fetch("/api/auth/me", { credentials: "include", cache: "no-store" })
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(d) { if (d) goAfterAuth(d.profile_complete); })
      .catch(function() {});
  </script>
</Layout>
