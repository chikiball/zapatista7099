---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Peta Alumni - 7099">
  <nav class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2 min-w-0">
        <a href="/" class="text-xl font-bold text-amber-900 shrink-0"><img src="/logo-nav.png" alt="Alumni 7099" style="height:32px"></a>
        <span id="nav-welcome" class="hidden text-sm text-stone-500 truncate">Welcome, <span id="nav-welcome-name" class="font-semibold text-amber-900"></span></span>
      </div>
      <a href="/login" id="nav-login" class="text-sm text-amber-700 hover:underline shrink-0">Masuk</a>
    </div>
  </nav>
  <div class="max-w-6xl mx-auto px-4 py-4">
    <h2 class="text-2xl font-bold text-stone-800 mb-1">Peta Alumni</h2>
    <p class="text-stone-500 text-sm">Scroll/pinch zoom &#8226; Drag geser &#8226; Klik/tap pin &#8226; Double-klik reset ke globe</p>
  </div>

  <link href="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.css" rel="stylesheet" />

  <div id="wrap" style="width:100%;height:calc(100vh - 160px);min-height:400px;overflow:hidden;position:relative;background:#eef2f5;">
    <div id="map" style="position:absolute;inset:0;"></div>
    <div style="position:absolute;top:12px;left:12px;z-index:10;display:flex;gap:12px;align-items:center;font-size:12px;color:#57534e;background:rgba(255,255,255,.9);padding:6px 12px;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.1);backdrop-filter:blur(4px);pointer-events:none;">
      <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;border-radius:50%;background:#ff2020;display:inline-block;box-shadow:0 0 6px #ff2020;"></span> Alumni</span>
      <span id="cnt"></span>
    </div>
    <div id="login-banner" class="hidden" style="position:absolute;bottom:16px;left:50%;transform:translateX(-50%);z-index:10;background:rgba(120,85,30,.92);color:#fff;padding:10px 20px;border-radius:10px;font-size:13px;text-align:center;backdrop-filter:blur(4px);max-width:90%;">
      <a href="/login" style="color:#fde68a;text-decoration:underline;">Login</a> untuk melihat siapa yang ada di mana
    </div>
    <div id="burst" class="hidden" style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:80;pointer-events:none;"></div>
  </div>

  <script is:inline src="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.js"></script>
  <script is:inline>
  (function(){
    var PC='#ff2020';
    var HOME={center:[106.8,-6.2],zoom:1.3};
    var wrap=document.getElementById('wrap'),be=document.getElementById('burst');
    var loggedIn=false;

    fetch('/api/auth/me',{credentials:'include'}).then(function(r){
      if(r.ok){loggedIn=true;document.getElementById('login-banner').classList.add('hidden');
        r.json().then(function(d){var n=document.getElementById('nav-login');n.textContent='Profile';n.href='/profile';var w=document.getElementById('nav-welcome');if(w){document.getElementById('nav-welcome-name').textContent=d.user.name||d.user.email;w.classList.remove('hidden')}});
      }else{document.getElementById('login-banner').classList.remove('hidden')}
    }).catch(function(){document.getElementById('login-banner').classList.remove('hidden')});

    mapboxgl.accessToken='pk.eyJ1IjoiY2hpa2liYWxsIiwiYSI6ImNtcjY4bmtrdzBzOHoyeHNkOXo5MnpsbHoifQ.y4Bj-YE9f7jnztFYFCNB1Q';
    var map=new mapboxgl.Map({
      container:'map',
      style:'mapbox://styles/mapbox/streets-v12',
      projection:'globe',
      center:HOME.center,
      zoom:HOME.zoom,
      attributionControl:false
    });
    map.addControl(new mapboxgl.AttributionControl({compact:true}));
    map.addControl(new mapboxgl.NavigationControl({showCompass:false}),'top-right');
    map.doubleClickZoom.disable();

    map.on('style.load',function(){map.setFog({'horizon-blend':0.1,'color':'#f5f0e8','high-color':'#cbe0ef','space-color':'#0b1026','star-intensity':0.15})});

    map.on('load',function(){
      fetch('/api/map').then(function(r){return r.json()}).then(function(al){
        var feats=[];
        al.forEach(function(d){
          if(d.latitude==null||d.longitude==null)return;
          feats.push({type:'Feature',geometry:{type:'Point',coordinates:[d.longitude,d.latitude]},
            properties:{name:d.name||'',nickname:d.nickname||'',job_title:d.job_title||''}});
        });
        document.getElementById('cnt').textContent=feats.length+' alumni';
        map.addSource('alumni',{type:'geojson',data:{type:'FeatureCollection',features:feats},
          cluster:true,clusterRadius:44,clusterMaxZoom:14});

        // glow under clusters + points
        map.addLayer({id:'a-cluster-glow',type:'circle',source:'alumni',filter:['has','point_count'],
          paint:{'circle-color':PC,'circle-blur':1,'circle-opacity':0.35,
            'circle-radius':['step',['get','point_count'],16,10,22,50,30]}});
        map.addLayer({id:'a-cluster',type:'circle',source:'alumni',filter:['has','point_count'],
          paint:{'circle-color':PC,'circle-opacity':0.4,'circle-stroke-color':'#fff','circle-stroke-width':1.4,'circle-stroke-opacity':0.9,
            'circle-radius':['step',['get','point_count'],11,10,15,50,21]}});
        map.addLayer({id:'a-cluster-count',type:'symbol',source:'alumni',filter:['has','point_count'],
          layout:{'text-field':['get','point_count_abbreviated'],'text-font':['DIN Offc Pro Medium','Arial Unicode MS Bold'],'text-size':12},
          paint:{'text-color':'#fff'}});
        map.addLayer({id:'a-point-glow',type:'circle',source:'alumni',filter:['!',['has','point_count']],
          paint:{'circle-color':PC,'circle-blur':1,'circle-opacity':0.4,'circle-radius':10}});
        map.addLayer({id:'a-point',type:'circle',source:'alumni',filter:['!',['has','point_count']],
          paint:{'circle-color':PC,'circle-opacity':0.4,'circle-stroke-color':'#fff','circle-stroke-width':1.2,'circle-stroke-opacity':0.9,'circle-radius':6}});

        map.on('click','a-cluster',function(e){
          var f=e.features[0],cid=f.properties.cluster_id,coord=f.geometry.coordinates.slice();
          map.getSource('alumni').getClusterLeaves(cid,1000,0,function(err,leaves){
            if(err)return;
            var p=map.project(coord);
            if(bv&&be._cid==='c'+cid){hideBurst();return}
            showBurst(leaves,p.x,p.y,'c'+cid);
          });
        });
        map.on('click','a-point',function(e){
          var f=e.features[0],coord=f.geometry.coordinates.slice(),p=map.project(coord);
          if(bv&&be._cid==='p'+p.x+','+p.y){hideBurst();return}
          showBurst([f],p.x,p.y,'p'+p.x+','+p.y);
        });
        map.on('click',function(e){
          var hit=map.queryRenderedFeatures(e.point,{layers:['a-cluster','a-point']});
          if(!hit.length&&bv)hideBurst();
        });
        ['a-cluster','a-point'].forEach(function(l){
          map.on('mouseenter',l,function(){map.getCanvas().style.cursor='pointer'});
          map.on('mouseleave',l,function(){map.getCanvas().style.cursor=''});
        });
      });
    });

    // hide burst whenever the map moves (cards would go stale)
    map.on('movestart',function(){if(bv)hideBurst()});
    map.on('dblclick',function(){hideBurst();map.flyTo({center:HOME.center,zoom:HOME.zoom,speed:1.2})});

    // === STARBURST OVERLAY (login-gated) ===
    var bv=false,driftTimer=null;
    function inner(pr){
      var s='<b>'+pr.name+'</b>';
      if(pr.nickname)s+=' <span style="color:#92400e">('+pr.nickname+')</span>';
      if(pr.job_title)s+='<br><span style="color:#57534e">'+pr.job_title+'</span>';
      return s;
    }
    function showBurst(ms,x,y,id){
      if(!loggedIn)return;
      hideBurst();
      bv=true;be._cid=id;
      var wW=wrap.clientWidth,wH=wrap.clientHeight,n=ms.length,cards='';
      if(n===1){
        cards+='<div style="position:absolute;left:'+(x+15)+'px;top:'+(y-15)+'px;background:#fff;border:1px solid #d4c9b0;border-radius:8px;padding:5px 9px;box-shadow:0 2px 10px rgba(0,0,0,.18);font-size:11px;white-space:nowrap;pointer-events:auto">'+inner(ms[0].properties)+'</div>';
      }else{
        var mn=60,mx=Math.min(wW,wH)*0.38;
        for(var i=0;i<n;i++){
          var ang=(2*Math.PI*i/n)-(Math.PI/2),rad=mn+Math.random()*(mx-mn);
          var tx=Math.max(90,Math.min(wW-90,x+Math.cos(ang)*rad));
          var ty=Math.max(20,Math.min(wH-30,y+Math.sin(ang)*rad));
          cards+='<div class="bc" data-bx="'+tx+'" data-by="'+ty+'" style="position:absolute;left:'+tx+'px;top:'+ty+'px;transform:translate(-50%,-50%);background:#fff;border:1px solid #d4c9b0;border-radius:8px;padding:5px 9px;box-shadow:0 2px 8px rgba(0,0,0,.15);font-size:11px;white-space:nowrap;pointer-events:auto;transition:left 2.8s ease-in-out,top 2.8s ease-in-out">'+inner(ms[i].properties)+'</div>';
        }
      }
      be.innerHTML=cards;be.classList.remove('hidden');
      if(n>1){driftTimer=setInterval(function(){var els=be.querySelectorAll('.bc');for(var i=0;i<els.length;i++){var bx=parseFloat(els[i].getAttribute('data-bx')),by=parseFloat(els[i].getAttribute('data-by'));els[i].style.left=Math.max(90,Math.min(wW-90,bx+(Math.random()-.5)*60))+'px';els[i].style.top=Math.max(20,Math.min(wH-30,by+(Math.random()-.5)*60))+'px';els[i].style.zIndex=Math.floor(Math.random()*els.length)}},3000)}
    }
    function hideBurst(){bv=false;be.classList.add('hidden');be.innerHTML='';be._cid=null;if(driftTimer){clearInterval(driftTimer);driftTimer=null}}
  })();
  </script>
</Layout>
